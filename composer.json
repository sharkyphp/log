{
    "name": "sharkyphp/log",
    "description": "SharkyPHP logging package, provides a PSR-3 (psr/log) logger implementation with pluggable handlers.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sharky\\Log\\": "src"
        }
    },
    "authors": [
        {
            "name": "bytesharky",
            "email": "fish@doffish.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/log": "^3.0"
    },
    "archive": {
        "exclude": [
            "docs/",
            "tests/",
            ".github/",
            ".gitignore",
            "composer.lock",
            "vendor/",
            ".env"
        ]
    }
}
